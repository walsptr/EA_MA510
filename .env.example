# ===== Mode & Symbol =====
MODE=BACKTEST
SYMBOL=XAUUSDm

# ===== Timeframes =====
ENTRY_TIMEFRAME=M5
TREND_TIMEFRAME_1=M15
TREND_TIMEFRAME_2=M30

# ===== Moving Average =====
MA_LOW=5
MA_HIGH=10
MA_TYPE=EMA

# ===== Entry Trend MA Filter (optional, entry timeframe only) =====
# Each pair is optional. If you set one value within a pair, you must set the other:
# - Pair 1: TREND_MA_LOW_1 + TREND_MA_HIGH_1
# - Pair 2: TREND_MA_LOW_2 + TREND_MA_HIGH_2
# If both pairs are set, both are used as entry filters.
TREND_MA_LOW_1=20
TREND_MA_HIGH_1=50
TREND_MA_LOW_2=50
TREND_MA_HIGH_2=100

# ===== Backtest Range (only MODE=BACKTEST) =====
BACKTEST_START_DATE=2026-07-01
BACKTEST_END_DATE=2026-07-30
BACKTEST_WARMUP_DAYS=200
BACKTEST_INITIAL_BALANCE=15
BACKTEST_SPREAD_POINTS=20
BACKTEST_SLIPPAGE_POINTS=5
# BACKTEST_USE_MT5:
#   (empty)         → auto default: Windows=true, non-Windows=false.
#   false           → use SYNTHETIC data, no MT5 terminal needed, runs on Linux/Mac/Windows.
#   true            → use REAL historical data from MT5. WARNING:
#                     WINDOWS ONLY (MetaTrader5 PyPI package is Windows-only
#                     and requires a logged-in MT5 Terminal.exe).
BACKTEST_USE_MT5=true

# ===== Position Sizing =====
# SIZING_MODE: FIXED_LOT/RISK_PERCENT
SIZING_MODE=FIXED_LOT
FIXED_LOT_SIZE=0.01
RISK_PERCENT_PER_TRADE=1

# ===== Stop Loss / Take Profit (MODE: FIXED | ATR | DOLLAR) =====
# DOLLAR mode: SL/TP in dollars per position (not per lot)
SL_MODE=DOLLAR
SL_POINTS=
SL_ATR_MULTIPLIER=
SL_DOLLAR=0.5

TP_MODE=DOLLAR
TP_POINTS=
TP_ATR_MULTIPLIER=
TP_DOLLAR=10.0

ATR_PERIOD=14

# ===== Trailing Stop (optional) =====
TRAILING_STOP_ENABLED=false
TRAILING_STOP_POINTS=
TRAILING_STOP_ACTIVATION_POINTS=

# ===== Trade Management =====
EXIT_ON_OPPOSITE_SIGNAL=true
# Trading window (optional, follows DISPLAY_TIMEZONE)
DISPLAY_TIMEZONE=UTC
TRADING_WINDOW_START=
TRADING_WINDOW_END=
MAX_CONCURRENT_POSITIONS=1
MAX_SPREAD_POINTS=50
MAX_DAILY_LOSS_PERCENT=1
MAGIC_NUMBER=20260101

# ===== Live Mode / MT5 Connection (MODE=LIVE) =====
LIVE_POLL_INTERVAL_SECONDS=5
LIVE_WARMUP_DAYS=0
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ===== Logging / Output =====
LOG_LEVEL=INFO
LOG_DIR=./logs
REPORT_DIR=./reports
