# ===== Mode & Symbol =====
MODE=BACKTEST
SYMBOL=XAUUSDm

# ===== Timeframes =====
ENTRY_TIMEFRAME=M5
TREND_TIMEFRAME_1=M15
TREND_TIMEFRAME_2=M30

# ===== Moving Average =====
MA_LOW=5
MA_HIGH=10
MA_TYPE=EMA

# ===== Backtest Range (only MODE=BACKTEST) =====
BACKTEST_START_DATE=2025-01-01
BACKTEST_END_DATE=2025-12-31
BACKTEST_INITIAL_BALANCE=1000
BACKTEST_SPREAD_POINTS=20
BACKTEST_SLIPPAGE_POINTS=5
# BACKTEST_USE_MT5:
#   false (default) → pakai SYNTHETIC data, tidak perlu MT5 terminal, jalan di Linux/Mac/Windows.
#   true            → coba pakai data HISTORI RIIL dari MT5. PERINGATAN:
#                     HANYA BERJALAN DI WINDOWS (MetaTrader5 package PyPI = Windows-only
#                     dan butuh MT5 Terminal.exe yang sudah login). Jika gagal akan auto
#                     fallback ke synthetic (dengan WARNING).
BACKTEST_USE_MT5=false

# ===== Position Sizing =====
SIZING_MODE=RISK_PERCENT
FIXED_LOT_SIZE=0.01
RISK_PERCENT_PER_TRADE=1

# ===== Stop Loss / Take Profit (MODE: FIXED | ATR | DOLLAR) =====
# DOLLAR mode: SL/TP dalam dollar per posisi (bukan per lot)
SL_MODE=DOLLAR
SL_POINTS=
SL_ATR_MULTIPLIER=
SL_DOLLAR=5.0

TP_MODE=DOLLAR
TP_POINTS=
TP_ATR_MULTIPLIER=
TP_DOLLAR=15.0

ATR_PERIOD=14

# ===== Trailing Stop (optional) =====
TRAILING_STOP_ENABLED=false
TRAILING_STOP_POINTS=
TRAILING_STOP_ACTIVATION_POINTS=

# ===== Trade Management =====
EXIT_ON_OPPOSITE_SIGNAL=false
MAX_CONCURRENT_POSITIONS=1
MAX_SPREAD_POINTS=50
MAX_DAILY_LOSS_PERCENT=5
MAGIC_NUMBER=20260101

# ===== Live Mode / MT5 Connection (MODE=LIVE) =====
LIVE_POLL_INTERVAL_SECONDS=5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ===== Logging / Output =====
LOG_LEVEL=INFO
LOG_DIR=./logs
REPORT_DIR=./reports
